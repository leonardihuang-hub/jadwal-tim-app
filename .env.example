# Database (Employee, leave-requests, swap-requests) -- Postgres.
# Lokal: bisa pakai Postgres lokal, atau langsung ke instance cloud (mis.
# Vercel Postgres/Neon) supaya sama dengan yang dipakai di production.
# Formatnya: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Login production lewat ops-sso (broker Google Sign-In terpusat kantor,
# lihat README-OPS-SSO.md) -- app ini tidak bikin OAuth Client Google
# sendiri, cukup didaftarkan sebagai client di ops-sso. OPS_SSO_CLIENT_ID
# dan OPS_SSO_CLIENT_SECRET didapat dari operator ops-sso saat register app
# ini (redirect_uri yang didaftarkan: <NEXTAUTH_URL>/api/auth/sso/callback).
OPS_SSO_BASE_URL=https://operations.esb.co.id/sso
OPS_SSO_CLIENT_ID=
OPS_SSO_CLIENT_SECRET=

# Google OAuth langsung (alternatif ops-sso, kalau suatu saat mau bikin
# OAuth Client sendiri tanpa lewat broker) -- biarkan kosong kalau pakai
# ops-sso di atas. Buat di https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Batasi login hanya untuk domain Google Workspace tim kamu
ALLOWED_GOOGLE_DOMAIN=namaperusahaan.com

# Apps Script Web App (untuk baca/tulis Google Sheets) -- lihat README bagian
# "Sinkron Google Sheet" untuk cara deploy script-nya. APPS_SCRIPT_URL adalah
# URL yang muncul setelah deploy ("https://script.google.com/macros/s/xxx/exec"),
# APPS_SCRIPT_TOKEN adalah kata sandi rahasia yang kamu tentukan sendiri di
# dalam script itu (harus sama persis di dua tempat).
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Nama tab di Google Sheet yang berisi jadwal
GOOGLE_SHEET_TAB_NAME=Calendar PS
